# Copy to .env for local overrides. .env is gitignored.
# The smoke test does not read this file and does not print variable values.

# Optional. Use a token for gated Hugging Face assets or higher rate limits.
# HF_TOKEN=

# Keep downloaded weights and datasets outside the files Git tracks.
# HF_HOME=artifacts/hf_home
# HF_DATASETS_CACHE=artifacts/hf_datasets
